# Local API URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Client IDs. Locally they can come from here; EAS builds use
# the values from app.json (extra.google*ClientId).
CLIENT_ID_WEB=
CLIENT_ID_IOS=
CLIENT_ID_ANDROID=

# Alternative with the EXPO_PUBLIC_ prefix (inlined into the bundle).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
