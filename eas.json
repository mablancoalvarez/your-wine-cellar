{
  "cli": {
    "version": ">= 3.8.0",
    "appVersionSource": "local"
  },
  "build": {
    /**
     * DEVELOPMENT profile for a physical iPhone.
     * - Development client: hot reload against Metro.
     * - `distribution: internal` produces an installable build via link/QR.
     * - Requires registering the device (`eas device:create`) and an Apple
     *   Developer account for ad hoc distribution.
     */
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    /**
     * SIMULATOR profile (macOS). Does not need Apple signing or local
     * CocoaPods: EAS builds in the cloud and returns a .tar.gz to drag into
     * the simulator.
     */
    "simulator": {
      "extends": "development",
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    },
    /**
     * PREVIEW profile
     * - Intended for QA or sharing the app internally before release.
     * - It is a "production" build but is not submitted to the stores automatically.
     */
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
    /**
     * PRODUCTION profile
     * - Intended for the final release on Google Play Store or Apple App Store.
     * - Uses the final keystore (signing key), the one linked to Google Cloud.
     */
  },
  "submit": {
    /**
     * EAS Submit configuration (optional)
     * Defines how the generated artifact should be uploaded to Google Play/App Store.
     */
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}