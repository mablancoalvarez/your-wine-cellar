# Local Postgres from docker-compose. Development only: in production this
# URL must come from the server environment and must not be committed.
DATABASE_URL=postgresql://cellar:cellar@localhost:5433/cellar
JWT_ACCESS_SECRET=cambia-este-secreto-en-local

# Google Client IDs separated by commas (web, iOS, Android).
GOOGLE_CLIENT_IDS=
# Optional: primary web client. If missing, the first GOOGLE_CLIENT_IDS entry is used.
# GOOGLE_WEB_CLIENT_ID=
# Only used for the web client. iOS/Android clients are public.
GOOGLE_CLIENT_SECRET=

PORT=3000
